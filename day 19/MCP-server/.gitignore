# Dependencies
node_modules/

# Build output
dist/
web/dist/

# Runtime data (logs, scheduler database, generated files)
data/*
!data/.gitkeep
!data/logs/.gitkeep
*.log

# Local overrides / secrets
.env
.env.local
config/*.local.json
# Отдельный файл секретов: токены/keys НЕ должны попадать в git
config/credentials.json

# SQLite databases (scheduler + pipelines)
data/scheduler.db
data/scheduler.db-*
data/pipelines.db
data/pipelines.db-*

# LLM settings (API key) и сгенерированные pipeline-файлы
data/llm.json
data/output/
data/output/*

# OS / editor
.DS_Store
.idea/
.vscode/
*.tsbuildinfo