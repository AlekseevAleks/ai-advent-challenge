# RAG Document Indexing Lab — пример конфигурации backend
# Скопируйте файл в .env и при необходимости измените значения.

# Адрес локального сервера Ollama
OLLAMA_URL=http://localhost:11434

# Модель эмбеддингов (должна быть установлена: ollama pull nomic-embed-text)
EMBEDDING_MODEL=nomic-embed-text

# Размер batch для генерации эмбеддингов
EMBEDDING_BATCH_SIZE=32

# Число повторных попыток при временных ошибках Ollama
EMBEDDING_RETRIES=3

# Таймауты (секунды)
OLLAMA_TIMEOUT=120.0
OLLAMA_CONNECTION_TIMEOUT=10.0

# Лимиты загрузки файлов
MAX_FILE_SIZE_MB=50
MAX_FILES_PER_REQUEST=100

# Директория хранения (загруженные файлы, коллекции, индексы, SQLite)
STORAGE_DIR=storage

# Параметры chunking по умолчанию (переопределяются на странице «Индексация»)
DEFAULT_CHUNK_SIZE=1200
DEFAULT_CHUNK_OVERLAP=200
DEFAULT_STRUCTURAL_MAX_CHUNK_SIZE=1500
DEFAULT_STRUCTURAL_MIN_CHUNK_SIZE=200

# RAG-эксперименты: реранкинг, фильтрация, query rewrite
QUERY_REWRITE_MODEL=llama3.2
RERANKER_TYPE=heuristic
RERANKER_MODEL=BAAI/bge-reranker-base
DEFAULT_INITIAL_TOP_K=20
DEFAULT_FINAL_TOP_K=5
DEFAULT_SIMILARITY_THRESHOLD=0.65

# Хост/порт запуска uvicorn
HOST=127.0.0.1
PORT=8000

# Разрешённые CORS-оригины frontend (через запятую)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000