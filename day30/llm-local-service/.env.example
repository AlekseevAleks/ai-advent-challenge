# =====================================================================
#  Пример конфигурации локального LLM-сервиса.
#  Скопируйте этот файл в .env и отредактируйте под себя:
#      cp .env.example .env
#  Реальных секретов в этом файле быть не должно.
# =====================================================================

# ---------------------------- Сеть API -------------------------------
# 127.0.0.1 — сервис доступен ТОЛЬКО с этого компьютера (безопасно по умолчанию).
# 0.0.0.0     — сервис слушает все сетевые интерфейсы. Используйте только
#               если понимаете риски и ограничили доступ межсетевым экраном
#               (см. README, раздел «Доступ из домашней сети»).
HOST=127.0.0.1
PORT=5012

# ---------------------------- Логи -----------------------------------
# SILENT | ERROR | WARNING | INFO | DEBUG
LOG_LEVEL=INFO
# Содержимое сообщений и ответов никогда не пишется в логи.

# API key отключён в localhost-only режиме. Для LAN доступа задайте случайный
# секрет длиной не менее 32 символов и отправляйте его в Authorization: Bearer.
# Защищает панель управления, /chat и /api/admin/*.
API_KEY=

# ----------------- OpenAI-совместимый доступ -----------------------
# Имя модели, которое видит AI-агент (base_url: http://127.0.0.1:5012/v1).
OPENAI_MODEL_ALIAS=local-llm
# Ключ именно для маршрутов /v1/*. Если пусто, используется API_KEY (если задан).
# Пример значения: OPENAI_API_KEY=$(openssl rand -hex 24)
OPENAI_API_KEY=
# Требовать ли ключ для GET /v1/models. SDK агента передаёт ключ и туда.
OPENAI_REQUIRE_API_KEY_FOR_MODELS=true

# ---------------------------- Ollama ---------------------------------
# Адрес локального сервера Ollama. Наружу этот порт открывать НЕЛЬЗЯ.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# По умолчанию разрешён только loopback. Включайте true лишь для доверенного
# Ollama-хоста в собственной домашней сети (не для публичного URL).
ALLOW_REMOTE_OLLAMA=false
# Имя модели в Ollama (см. `ollama list`).
# Компактный стартовый вариант: llama3.2:3b (~2 ГБ, квантование Q4_K_M).
OLLAMA_MODEL=llama3.2:3b
# Полный таймаут одного запроса к Ollama, секунды.
OLLAMA_TIMEOUT=120
# Таймаут установки TCP-соединения, секунды.
OLLAMA_CONNECT_TIMEOUT=5
# Сколько раз повторить запрос при обрыве соединения (только для сетевых ошибок).
OLLAMA_MAX_RETRIES=1
# Размер контекстного окна, который запрашивается у Ollama (num_ctx).
# Должен быть согласован с MAX_CONTEXT_TOKENS + MAX_OUTPUT_TOKENS.
OLLAMA_NUM_CTX=4608
# Сколько запросов к Ollama разрешено выполнять одновременно.
# Значение 1 = строгая очередь: на слабом железе это предсказуемее.
# Значение 0 = без ограничения (Ollama сама решает, что делать).
OLLAMA_MAX_CONCURRENCY=1

# ------------------------- Ограничения контекста ---------------------
# Максимальная длина ОДНОГО сообщения в символах.
MAX_MESSAGE_CHARS=4000
# Максимальное количество сообщений в истории (включая system и текущее user).
MAX_HISTORY_MESSAGES=20
# Максимальное количество токенов ВХОДНОГО контекста (system + история + новый запрос).
MAX_CONTEXT_TOKENS=4096
# Сколько токенов резервируется под ответ модели.
MAX_OUTPUT_TOKENS=512
# Резерв на погрешность оценки токенов. Из MAX_CONTEXT_TOKENS вычитается
# указанная доля, чтобы запрос не оказался чуть больше лимита из-за токенизатора.
CONTEXT_TOKEN_TOLERANCE=0.05

# Как считать токены:
#   heuristic — консервативная эвристика (по умолчанию, без внешних зависимостей);
#   tiktoken  — альтернативная приблизительная оценка cl100k_base (если установлен пакет).
TOKENIZER=heuristic

# ---------------------- Журналирование запросов ----------------------
# Сохраняет ПОЛНЫЕ тексты сообщений и ответов в JSON-файлах.
# Файлы чувствительны, не коммитьте каталог logs/requests.
REQUEST_LOG_ENABLED=true
REQUEST_LOG_DIR=logs/requests
REQUEST_LOG_MAX_ENTRIES=500

# ----------------------------- Rate limit ----------------------------
# Формат: <число>/<период>, где период — second | minute | hour | day.
RATE_LIMIT=10/minute
# Учитывать ли X-Forwarded-For. Оставляйте false, если перед API нет
# доверенного реверс-прокси: иначе клиент подделает свой IP.
TRUST_PROXY_HEADERS=false
# Список доверенных IP прокси через запятую (используется только при
# TRUST_PROXY_HEADERS=true).
TRUSTED_PROXIES=127.0.0.1,::1
# Сколько последних нарушений лимита помнить (для наблюдаемости, без содержимого).
RATE_LIMIT_VIOLATION_BUFFER=100
